{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Binance Auto Trader",
  "version": "0.1.0",
  "identifier": "com.binance-auto.trader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ETH AUTO · Binance Trading",
        "width": 1440,
        "height": 1024,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://data-api.binance.vision wss://data-stream.binance.vision http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
