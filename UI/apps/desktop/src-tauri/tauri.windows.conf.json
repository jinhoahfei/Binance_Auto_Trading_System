{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "node scripts/desktopFrontend.mjs dev",
    "beforeBuildCommand": "node scripts/desktopFrontend.mjs build"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/binance-auto-sidecar"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
