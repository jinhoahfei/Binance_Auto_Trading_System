    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "@xstate/react": "6.1.0",
    "lightweight-charts": "5.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xstate": "5.32.5"
  },
  "devDependencies": {
